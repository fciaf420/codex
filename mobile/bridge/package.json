{
  "name": "@codex/mobile-bridge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local Codex <-> mobile-PWA bridge: spawns `codex app-server`, proxies JSON-RPC over an authenticated WebSocket.",
  "bin": {
    "codex-mobile-bridge": "./bin/codex-mobile-bridge.mjs"
  },
  "files": ["bin", "dist"],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup src/index.ts --format esm --target node22 --out-dir dist --clean --sourcemap",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@codex/mobile-shared": "workspace:*",
    "@fastify/multipart": "9.0.1",
    "@fastify/static": "8.0.3",
    "@fastify/websocket": "11.0.1",
    "fastify": "5.1.0",
    "pino": "9.5.0",
    "pino-pretty": "13.0.0",
    "qrcode": "1.5.4",
    "selfsigned": "2.4.1",
    "ws": "8.18.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/qrcode": "1.5.5",
    "@types/ws": "8.5.13",
    "tsup": "8.3.5",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  },
  "engines": {
    "node": ">=22"
  }
}
