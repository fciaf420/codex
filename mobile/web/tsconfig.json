{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "types": ["vite/client", "vite-plugin-pwa/client"],
    "useDefineForClassFields": true
  },
  "include": ["src", "vite.config.ts"],
  "exclude": ["src/sw.ts"]
}
