{
  "name": "@codex/mobile-shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./generated/*": {
      "types": "./dist-types/*.ts",
      "default": "./dist-types/*.ts"
    }
  },
  "files": ["src", "dist-types"],
  "scripts": {
    "sync-types": "node scripts/copy-schema-types.mjs",
    "build": "pnpm run sync-types",
    "clean": "rm -rf dist-types"
  }
}
